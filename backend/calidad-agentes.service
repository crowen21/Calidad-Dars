[Unit]
Description=Calidad Agentes DARS - backend FastAPI
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/var/www/dars-calidad/backend
Environment=CALIDAD_AGENTES_API_KEY=CAMBIA_ESTA_CLAVE
ExecStart=/var/www/dars-calidad/backend/venv/bin/uvicorn main:app --host 127.0.0.1 --port 8001
Restart=on-failure

[Install]
WantedBy=multi-user.target
